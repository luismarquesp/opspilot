{
  "name": "ops-pilot",
  "version": "1.0.0",
  "description": "Ops Pilot - Autonomous Agents Project",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/http/index.ts",
    "arena": "tsx --env-file=.env src/arena.ts",
    "bench": "tsx --env-file=.env src/bench.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "test": "node --import tsx --test \"src/**/!(server).test.ts\" && node --import tsx --test --test-concurrency=1 \"src/mcp/server.test.ts\"",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
